router.get('/profit-summary', protect, adminOnly, (req, res) => {
    res.json({
        success: true,
        data: {
            totalPlans: Object.keys(profitConfig).length,
            totalProfit: Object.values(profitConfig).reduce((sum, p) => sum + p.profit, 0),
            averageProfit: Math.round(Object.values(profitConfig).reduce((sum, p) => sum + p.profit, 0) / Object.keys(profitConfig).length),
            plans: profitConfig
        }
    });
});

